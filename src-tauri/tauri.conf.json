{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mermaid Local Editor",
  "version": "0.5.1",
  "identifier": "app.mermaid.localeditor",
  "build": {
    "beforeDevCommand": "npm run dev:renderer",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:renderer",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mermaid Local Editor",
        "width": 1280,
        "height": 800,
        "minWidth": 640,
        "minHeight": 480,
        "backgroundColor": "#1e1f23"
      }
    ],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; worker-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": []
  }
}
